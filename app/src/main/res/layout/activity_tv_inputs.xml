<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/tv_inputs_panel"
        android:layout_width="@dimen/settings_panel_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#E60F0F12"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tv_inputs_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="@string/tv_inputs"
            android:textColor="@color/on_background"
            android:textSize="@dimen/settings_popup_title_text_size" />

        <ScrollView
            android:id="@+id/tv_inputs_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:focusable="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tv_inputs_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/tv_inputs_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/primary"
            android:textSize="@dimen/settings_small_text_size" />
    </LinearLayout>
</FrameLayout>
