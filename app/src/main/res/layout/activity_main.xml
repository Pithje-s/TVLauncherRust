<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <FrameLayout
        android:id="@+id/background_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/background_bis"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/background_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/background_dim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000" />
    </FrameLayout>

    <View
        android:id="@+id/sleep_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sleep_gradient"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/launcher_interface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/interface_padding"
        android:weightSum="3.3"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/time"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/big_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-thin"
                android:includeFontPadding="false"
                android:shadowColor="#33000000"
                android:shadowDx="0.5"
                android:shadowDy="1"
                android:shadowRadius="7"
                tools:text="12:00"
                android:textColor="@color/on_background"
                android:textSize="@dimen/clock_text_size" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-light"
                android:shadowColor="#33000000"
                android:shadowDx="0.5"
                android:shadowDy="1"
                android:shadowRadius="7"
                tools:text="Понедельник 16 ноября"
                android:textColor="@color/on_background"
                android:textSize="@dimen/date_text_size" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/greetings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-light"
                android:maxWidth="256dp"
                android:shadowColor="#33000000"
                android:shadowDx="0.5"
                android:shadowDy="1"
                android:shadowRadius="7"
                android:singleLine="true"
                tools:text="Добрый день!"
                android:textColor="@color/on_background"
                android:textSize="@dimen/greeting_text_size" />

            <TextView
                android:id="@+id/weather_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-light"
                android:shadowColor="#33000000"
                android:shadowDx="0.5"
                android:shadowDy="1"
                android:shadowRadius="7"
                android:text="@string/weather_current"
                android:textColor="@color/on_background"
                android:textSize="@dimen/weather_text_size" />

            <TextView
                android:id="@+id/weather_forecast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                tools:text="максимальная температура воздуха сегодня 3°"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/weather_text_size"
                android:visibility="gone" />
        </LinearLayout>
        <FrameLayout
            android:id="@+id/widgets"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.3"
            android:clipChildren="false">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/widgets_buttons_reserve"
                android:clipChildren="false">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clipChildren="false">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/linkblocks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:scrollbars="none" />

                <ImageView
                    android:id="@+id/arrow_left"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:alpha="0"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_left" />

                <ImageView
                    android:id="@+id/arrow_right"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:alpha="0"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right" />

                <TextView
                    android:id="@+id/empty_apps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="@string/empty_apps"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/settings_row_text_size"
                    android:visibility="gone" />
            </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:clipChildren="false"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/tv_inputs_button"
                    android:layout_width="@dimen/settings_button_size"
                    android:layout_height="@dimen/settings_button_size"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_settings_normal"
                    android:clickable="true"
                    android:contentDescription="@string/tv_inputs"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/settings_icon_size"
                        android:layout_height="@dimen/settings_icon_size"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_tv_input" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/all_apps_button"
                    android:layout_width="@dimen/settings_button_size"
                    android:layout_height="@dimen/settings_button_size"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_settings_normal"
                    android:clickable="true"
                    android:contentDescription="@string/settings_all_apps_title"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/settings_icon_size"
                        android:layout_height="@dimen/settings_icon_size"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_all_apps" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/settings_button_container"
                    android:layout_width="@dimen/settings_button_size"
                    android:layout_height="@dimen/settings_button_size"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_settings_normal"
                    android:clickable="true"
                    android:contentDescription="@string/settings"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/settings_icon_size"
                        android:layout_height="@dimen/settings_icon_size"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_settings" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
